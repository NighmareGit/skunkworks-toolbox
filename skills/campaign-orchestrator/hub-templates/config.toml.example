base_url = "http://127.0.0.1:8080/v1"
api_key = <redacted>
temperature = 0.6
max_completion_tokens = 32768
context_window = 131072
stream_tool_calls = true

[marketplace]
official_marketplace_auto_installed = true
default_skills_installs_purged = true

[[marketplace.sources]]
name = "xAI Official"
git = "https://github.com/xai-org/plugin-marketplace.git"

[ui]
max_thoughts_width = 120
fork_secondary_model = "deepseek-v4-flash"
yolo = false
compact_mode = false
permission_mode = "always-approve"
show_timestamps = true

[cli]
installer = "internal"
auto_update = true

[subagents.models]
explore = "local-gemma-4-e4b"

[subagents.toggle]
explore = true
plan = true

# ─────────────────────────────────────────────────────────────
# Sub-agent Roles (model routing + scoped system prompts)
#
# Orchestrator tier  → deepseek-v4-flash (coordination, verification)
# Worker tier        → longcat            (research, implementation, general)
#
# Role prompt files live in ~/.grok/prompts/<role>.md
# Full architecture: ~/.grok/ROLE-ARCHITECTURE.md
# ─────────────────────────────────────────────────────────────

[subagents.roles.researcher]
description = "Deep research agent (longcat). Reads primary sources, cites paths, produces structured notes. Bounded: max 3 search avenues, cites evidence, never derives content."
model = "longcat"
prompt_file = "{{GROK_HOME}}/prompts/researcher.md"
default_capability_mode = "read-only"
reasoning_effort = "medium"

[subagents.roles.implementer]
description = "Implementation agent (longcat). Reads specs/review notes, implements smallest change, follows existing patterns, tests before done. Rails: bounded scope, no refactoring beyond task."
model = "longcat"
prompt_file = "{{GROK_HOME}}/prompts/implementer.md"
default_capability_mode = "all"
reasoning_effort = "medium"

[subagents.roles.general]
description = "General-purpose worker agent (longcat). Executes well-scoped tasks with a clear goal. Rails: tool-call budget, stop-and-report, no scope creep."
model = "longcat"
prompt_file = "{{GROK_HOME}}/prompts/general.md"
default_capability_mode = "all"
reasoning_effort = "medium"

[subagents.roles.planner]
description = "Planning/architect agent (longcat). Reads codebase/docs, produces structured implementation plan. Read-only: plans, never executes. (Renamed from 'plan' — the built-in plan type cannot be shadowed at user scope.)"
model = "longcat"
prompt_file = "{{GROK_HOME}}/prompts/planner.md"
default_capability_mode = "read-only"
reasoning_effort = "high"

[subagents.roles.verifier]
description = "Verification agent (deepseek-v4-flash). Independently checks outputs against contracts: file exists, size, format, required sections. Never trusts self-report."
model = "deepseek-v4-flash"
prompt_file = "{{GROK_HOME}}/prompts/verifier.md"
default_capability_mode = "read-only"
reasoning_effort = "low"

[subagents.roles.orchestrator]
description = "Orchestrator agent (deepseek-v4-flash). Coordinates campaigns: state machine, dispatch, verification, recovery, decision logging. Delegates execution, retains verification."
model = "deepseek-v4-flash"
prompt_file = "{{GROK_HOME}}/prompts/orchestrator.md"
default_capability_mode = "all"
reasoning_effort = "low"

[subagents.roles.math-enforcer]
description = "Enforces Python tool use for all numerical / validation tasks"
model = "deepseek-v4-flash"
prompt_file = '{{GROK_HOME}}/prompts/math_enforcer.md'
default_capability_mode = "execute"

[session]
auto_compact_threshold_percent = 82
